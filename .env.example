# TraceGuard AI - environment configuration template.
# Copy to `.env` and adjust. NEVER commit a real `.env` with secrets.
#   cp .env.example .env

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (CHANGE jwt_secret for any shared/non-local use) ---
JWT_SECRET=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Initial admin bootstrap (created on first startup if absent) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_EMAIL=admin@traceguard.local

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=traceguard
POSTGRES_PASSWORD=traceguard
POSTGRES_DB=traceguard

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=traceguard123

# --- Object storage (MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_REPORTS=reports
S3_USE_SSL=false
# Optional; leave blank for local MinIO unless its KMS/SSE support is configured.
S3_SERVER_SIDE_ENCRYPTION=

# --- LLM provider ---
# mock = fully offline deterministic responses (hackathon-safe default).
# openai = call OpenAI (requires OPENAI_API_KEY).
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- External intelligence APIs ---
# mock = deterministic fixtures (no network). live = real API (keys required).
OSINT_MODE=mock
CRYPTO_MODE=mock
VIRUSTOTAL_API_KEY=
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

# --- IBM Z integration ---
# mock = clearly-labelled SIMULATED scoring (default). real = call ML for z/OS.
IBMZ_MODE=mock
IBMZ_ENDPOINT=
IBMZ_API_TOKEN=

# --- Evidence processing limits ---
MAX_UPLOAD_BYTES=26214400
EXIFTOOL_TIMEOUT_SECONDS=30
# Comma-separated upload allowlist. Office/text types are scanned for identifiers.
# ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/tiff,application/pdf,text/plain,text/csv,text/xml,text/markdown,application/json,application/xml,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation
# Max characters extracted per file for content/identifier scanning.
CONTENT_EXTRACT_MAX_CHARS=500000
# Max indicators auto-registered from file content per investigation run.
CONTENT_MAX_INDICATORS_PER_RUN=500

# --- Orchestration ---
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2
DEFENSE_MAX_ROUNDS=2
